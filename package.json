{
  "name": "mcp-watch",
  "version": "2.0.2",
  "description": "Security scanner for Model Context Protocol (MCP) servers - detect vulnerabilities and security issues",
  "main": "dist/main.js",
  "bin": {
    "mcp-watch": "./dist/main.js"
  },
  "scripts": {
    "build": "tsc && chmod +x dist/main.js",
    "dev": "ts-node src/main.ts",
    "start": "node dist/main.js",
    "scan": "ts-node src/main.ts scan",
    "scan-local": "ts-node src/main.ts scan-local",
    "scan:github": "node dist/main.js scan",
    "scan:local": "node dist/main.js scan-local",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build",
    "prepare": "npm run build",
    "type-check": "tsc --noEmit"
  },
  "author": "Kapil Duraphe",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kapilduraphe/mcp-watch.git"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "tmp": "^0.2.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.3.1",
    "@types/tmp": "^0.2.4",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.72.2"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.5"
    }
  }
}
